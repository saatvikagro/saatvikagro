# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# Final live URL of the website (no trailing slash)
VITE_SITE_URL=https://www.saatvikagro.com

# Contact form endpoint (Formspree, Web3Forms, or Netlify Forms URL)
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Google Maps embed API key (leave blank to use iframe embed without key)
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
